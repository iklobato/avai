<?xml version="1.0" encoding="UTF-8"?>
<!-- Hardened-runtime entitlements for codesign + notarization.
     PyInstaller-frozen CPython needs unsigned executable memory, and the
     bundled dylibs need library-validation relaxed. UNVERIFIED until a
     notarized build runs in CI. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
